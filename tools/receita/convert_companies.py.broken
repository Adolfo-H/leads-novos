#!/usr/bin/env python3

import argparse
import re
import sys
import tempfile
from pathlib import Path
from zipfile import BadZipFile, ZipFile

import duckdb


FILE_PATTERN = re.compile(
    r"^Empresas(\d+)\.zip$",
    re.IGNORECASE,
)

CHUNK_SIZE = 8 * 1024 * 1024
REPORT_STEP = 256 * 1024 * 1024


def human_size(value: int) -> str:
    units = [
        "B",
        "KiB",
        "MiB",
        "GiB",
    ]

    size = float(value)

    for unit in units:
        if (
            size < 1024
            or unit == units[-1]
        ):
            return f"{size:.2f} {unit}"

        size /= 1024

    return f"{size:.2f} GiB"


def transcode_zip_member(
    zip_path: Path,
    target: Path,
) -> int:
    try:
        archive = ZipFile(
            zip_path
        )
    except BadZipFile as exception:
        raise RuntimeError(
            f"ZIP inválido: {zip_path}"
        ) from exception

    with archive:
        members = [
            item
            for item in archive.infolist()
            if not item.is_dir()
        ]

        if len(members) != 1:
            raise RuntimeError(
                "Era esperado exatamente "
                "um arquivo interno em "
                f"{zip_path.name}."
            )

        member = members[0]

        print(
            "[member]",
            member.filename,
        )

        print(
            "[uncompressed]",
            human_size(
                member.file_size
            ),
        )

        processed = 0
        next_report = REPORT_STEP

        with archive.open(
            member
        ) as source:
            with target.open(
                "w",
                encoding="utf-8",
                newline="",
            ) as destination:
                while True:
                    chunk = source.read(
                        CHUNK_SIZE
                    )

                    if not chunk:
                        break

                    destination.write(
                        chunk.decode(
                            "latin-1"
                        )
                    )

                    processed += len(
                        chunk
                    )

                    if processed >= next_report:
                        print(
                            "[transcode]",
                            human_size(
                                processed
                            ),
                        )

                        next_report += (
                            REPORT_STEP
                        )

        return processed


def convert_companies(
    period: str,
    filename: str,
    raw_root: Path,
    processed_root: Path,
) -> Path:
    match = FILE_PATTERN.fullmatch(
        filename
    )

    if not match:
        raise ValueError(
            "O arquivo deve seguir o padrão "
            "EmpresasN.zip."
        )

    part = int(
        match.group(1)
    )

    zip_path = (
        raw_root
        / period
        / filename
    )

    if not zip_path.exists():
        raise FileNotFoundError(
            f"Arquivo não encontrado: {zip_path}"
        )

    output_dir = (
        processed_root
        / period
        / "companies"
    )

    output_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    final_path = (
        output_dir
        / f"part-{part:02d}.parquet"
    )

    temporary_parquet = (
        output_dir
        / f".part-{part:02d}.parquet.tmp"
    )

    if temporary_parquet.exists():
        temporary_parquet.unlink()

    print(
        "[source]",
        zip_path,
    )

    print(
        "[target]",
        final_path,
    )

    with tempfile.TemporaryDirectory(
        prefix="receita-companies-"
    ) as temporary_directory:
        csv_path = (
            Path(
                temporary_directory
            )
            / "companies.csv"
        )

        transcode_zip_member(
            zip_path,
            csv_path,
        )

        connection = duckdb.connect()

        try:
            connection.execute(
                """
                CREATE TABLE raw AS
                SELECT *
                FROM read_csv(
                    ?,
                    delim = ';',
                    header = false,
                    all_varchar = true,
                    quote = '"',
                    escape = '"'
                )
                """,
                [
                    str(
                        csv_path
                    ),
                ],
            )

            columns = (
                connection.execute(
                    """
                    DESCRIBE raw
                    """
                )
                .fetchall()
            )

            if len(columns) != 7:
                raise RuntimeError(
                    "Layout inesperado em "
                    f"{filename}: "
                    f"{len(columns)} colunas."
                )

            raw_count = (
                connection.execute(
                    """
                    SELECT COUNT(*)
                    FROM raw
                    """
                )
                .fetchone()[0]
            )

            print(
                "[rows-raw]",
                raw_count,
            )

            connection.execute(
                """
                CREATE TABLE parsed_companies AS
                SELECT
                    row_number() OVER ()
                        AS source_row,

                    upper(
                        trim(column0)
                    ) AS cnpj_root,

                    trim(
                        column1
                    ) AS corporate_name,

                    nullif(
                        trim(column2),
                        ''
                    ) AS legal_nature_code,

                    nullif(
                        trim(column3),
                        ''
                    ) AS responsible_qualification_code,

                    try_cast(
                        replace(
                            nullif(
                                trim(column4),
                                ''
                            ),
                            ',',
                            '.'
                        )
                        AS DECIMAL(20, 2)
                    ) AS share_capital,

                    nullif(
                        trim(column5),
                        ''
                    ) AS size_code,

                    nullif(
                        trim(column6),
                        ''
                    ) AS federative_entity

                FROM raw
                """
            )

            connection.execute(
                """
                CREATE TABLE scored_companies AS
                SELECT
                    *,

                    (
                        CASE
                            WHEN corporate_name <> ''
                            THEN 100
                            ELSE 0
                        END

                        +

                        CASE
                            WHEN
                                legal_nature_code IS NOT NULL
                                AND legal_nature_code <> '0000'
                            THEN 20
                            ELSE 0
                        END

                        +

                        CASE
                            WHEN
                                responsible_qualification_code
                                IS NOT NULL

                                AND
                                responsible_qualification_code
                                <> '00'
                            THEN 10
                            ELSE 0
                        END

                        +

                        CASE
                            WHEN size_code IS NOT NULL
                            THEN 5
                            ELSE 0
                        END

                        +

                        CASE
                            WHEN share_capital > 0
                            THEN 2
                            ELSE 0
                        END

                        +

                        CASE
                            WHEN federative_entity IS NOT NULL
                            THEN 1
                            ELSE 0
                        END
                    ) AS quality_score

                FROM parsed_companies
                """
            )

            connection.execute(
                """
                CREATE TABLE ranked_companies AS
                SELECT
                    *,

                    row_number() OVER (
                        PARTITION BY cnpj_root
                        ORDER BY
                            quality_score DESC,
                            source_row ASC
                    ) AS duplicate_rank

                FROM scored_companies
                """
            )

            connection.execute(
                """
                CREATE TABLE companies AS
                SELECT
                    cnpj_root,
                    corporate_name,
                    legal_nature_code,
                    responsible_qualification_code,
                    share_capital,
                    size_code,
                    federative_entity

                FROM ranked_companies

                WHERE duplicate_rank = 1
                """
            )

            invalid_roots = (
                connection.execute(
                    """
                    SELECT COUNT(*)
                    FROM companies
                    WHERE
                        length(cnpj_root) <> 8
                        OR NOT regexp_full_match(
                            cnpj_root,
                            '[0-9A-Z]{8}'
                        )
                    """
                )
                .fetchone()[0]
            )

            if invalid_roots:
                raise RuntimeError(
                    "Foram encontradas "
                    f"{invalid_roots} raízes "
                    "de CNPJ inválidas."
                )

            invalid_capitals = (
                connection.execute(
                    """
                    SELECT COUNT(*)
                    FROM raw
                    WHERE
                        nullif(
                            trim(column4),
                            ''
                        ) IS NOT NULL

                        AND try_cast(
                            replace(
                                trim(column4),
                                ',',
                                '.'
                            )
                            AS DECIMAL(20, 2)
                        ) IS NULL
                    """
                )
                .fetchone()[0]
            )

            if invalid_capitals:
                raise RuntimeError(
                    "Foram encontrados "
                    f"{invalid_capitals} capitais "
                    "sociais inválidos."
                )

            duplicate_roots = (
                connection.execute(
                    """
                    SELECT COUNT(*)
                    FROM (
                        SELECT cnpj_root
                        FROM parsed_companies
                        GROUP BY cnpj_root
                        HAVING COUNT(*) > 1
                    )
                    """
                )
                .fetchone()[0]
            )

            if duplicate_roots:
                quality_dir = (
                    processed_root
                    / period
                    / "quality"
                )

                quality_dir.mkdir(
                    parents=True,
                    exist_ok=True,
                )

                duplicates_path = (
                    quality_dir
                    / (
                        "company-duplicates-"
                        f"part-{part:02d}.parquet"
                    )
                )

                if duplicates_path.exists():
                    duplicates_path.unlink()

                connection.execute(
                    """
                    COPY (
                        SELECT
                            *,
                            duplicate_rank = 1
                                AS selected

                        FROM ranked_companies

                        WHERE cnpj_root IN (
                            SELECT cnpj_root
                            FROM parsed_companies
                            GROUP BY cnpj_root
                            HAVING COUNT(*) > 1
                        )

                        ORDER BY
                            cnpj_root,
                            duplicate_rank
                    )
                    TO ?
                    (
                        FORMAT PARQUET,
                        COMPRESSION ZSTD
                    )
                    """,
                    [
                        str(
                            duplicates_path
                        ),
                    ],
                )

                print(
                    "[duplicates]",
                    duplicate_roots,
                )

                print(
                    "[quarantine]",
                    duplicates_path,
                )
                .fetchone()[0]
            )

            if duplicate_roots:
                raise RuntimeError(
                    "Foram encontradas "
                    f"{duplicate_roots} raízes "
                    "duplicadas dentro do arquivo."
                )

            company_count = (
                connection.execute(
                    """
                    SELECT COUNT(*)
                    FROM companies
                    """
                )
                .fetchone()[0]
            )

            if company_count != raw_count:
                raise RuntimeError(
                    "Contagem divergente: "
                    f"raw={raw_count}, "
                    f"companies={company_count}."
                )

            connection.execute(
                """
                COPY companies
                TO ?
                (
                    FORMAT PARQUET,
                    COMPRESSION ZSTD,
                    ROW_GROUP_SIZE 100000
                )
                """,
                [
                    str(
                        temporary_parquet
                    ),
                ],
            )

        finally:
            connection.close()

    temporary_parquet.replace(
        final_path
    )

    print(
        "[done]",
        final_path,
    )

    print(
        "[size]",
        human_size(
            final_path.stat().st_size
        ),
    )

    return final_path


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Converte arquivos EmpresasN.zip "
            "da Receita para Parquet."
        )
    )

    parser.add_argument(
        "--period",
        required=True,
    )

    parser.add_argument(
        "--file",
        required=True,
        dest="filename",
    )

    parser.add_argument(
        "--raw-root",
        default="/real-data/raw",
    )

    parser.add_argument(
        "--processed-root",
        default="/real-data/processed",
    )

    args = parser.parse_args()

    try:
        convert_companies(
            args.period,
            args.filename,
            Path(args.raw_root),
            Path(args.processed_root),
        )

    except (
        FileNotFoundError,
        RuntimeError,
        ValueError,
    ) as exception:
        print(
            "[error]",
            str(exception),
            file=sys.stderr,
        )

        return 1

    return 0


if __name__ == "__main__":
    sys.exit(
        main()
    )
